# PostgreSQL host port
POSTGRES_PORT=55432

# Local database (development only)
POSTGRES_DB=cinesense
POSTGRES_USER=cinesense
POSTGRES_PASSWORD=change-me-locally
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:55432/cinesense
SPRING_DATASOURCE_USERNAME=cinesense
SPRING_DATASOURCE_PASSWORD=change-me-locally

# Provider/model credentials (used only by the gated ingestion service or later model services).
# Keep real values in this ignored file or a managed secret store.
TMDB_API_KEY=
TMDB_API_READ_ACCESS_TOKEN=
TMDB_USAGE_SCOPE=
TMDB_TERMS_ACKNOWLEDGED=false
TMDB_ATTRIBUTION_ACKNOWLEDGED=false
TMDB_LOGO_ACKNOWLEDGED=false
TMDB_POLICY_REVIEWED_ON=
TMDB_SOURCE_POLICY=UNKNOWN
TMDB_PERSISTENCE_ACKNOWLEDGED=false
TMDB_TIMEOUT_SECONDS=15
TMDB_MAX_RETRIES=3
TMDB_MIN_REQUEST_INTERVAL_SECONDS=0.25
CINESENSE_DATABASE_URL=
HUGGINGFACE_HUB_TOKEN=
